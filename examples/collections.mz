## Collections, RFC-0013 §9 (C7): a list, a map and a set built with bracket literals and
## transformed in functions, indexing that gives an option read with `otherwise`, `in`, the
## methods of §9.2 and the named folds of §9.4.
## `mz run examples/collections.mz` prints what collections.expected holds; CI compares the two.
program collections

  enum suit
    hearts
    spades
  end

  fn main
    let primes = [2, 3, 5, 7, 11]
    print(primes)
    print("{primes.length()} primes: the first is {primes[0] otherwise 0}, the tenth {primes[9] otherwise -1}")
    print(sum_of_even_squares(range(1, to = 11)))
    print(primes.map(square))
    print(primes.filter(is_odd).sum())
    print(primes.fold(0, step = add))
    print("{primes.count(is_odd)} odd, any even: {primes.any(is_even)}, all odd: {primes.all(is_odd)}")
    print(primes.first(is_even) otherwise 0)
    print(primes.slice(1, to = 3) otherwise [])
    print(primes.slice(4, to = 9) otherwise [])
    print([5, 3, 9, 1].sort_by(negate))
    print(primes.group_by(is_odd))
    var ages: map(text, int) = ["ada": 36, "alan": 41]
    ages["grace"] = 85
    ages["ada"] = 37
    ages.remove("alan")
    print(ages)
    let grace = ages["grace"] otherwise 0
    let linus = ages["linus"] otherwise 0
    print("grace {grace}, linus {linus}, {ages.length()} people, {ages.values().sum()} years")
    print(ages.keys())
    var seen: set(int) = [3, 1, 3, 2]
    seen.insert(10)
    seen.remove(1)
    print("{seen} holds 3: {3 in seen}, {seen.to_list().length()} values")
    var hands: list(suit) = []
    print(hands is none)
    for each p in primes
      when p % 2 is 0
        hands.push(hearts)
      else
        hands.push(spades)
      end
    end
    hands[1] = hearts
    print(hands)
    print(hands is not none and spades in hands)
    let tags = ["a \"b\"", "c"]
    print(tags)
    print(tags.join(" + "))
  end fn main

  fn sum_of_even_squares(xs: list(int)): int
    return xs.filter(is_even).map(square).fold(0, step = add)
  end fn sum_of_even_squares

  fn square(n: int): int
    return n * n
  end fn square

  fn is_even(n: int): bool
    return n % 2 is 0
  end fn is_even

  fn is_odd(n: int): bool
    return n % 2 is 1
  end fn is_odd

  fn add(a: int, b: int): int
    return a + b
  end fn add

  fn negate(n: int): int
    return -n
  end fn negate

end program collections
