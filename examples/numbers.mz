## Numbers, RFC-0013 §4: `int` and `float`, never mixed without a conversion, integer
## division that truncates, IEEE 754 floats that never trap, and §3.8's text form.
## `mz run examples/numbers.mz` prints what numbers.expected holds; CI compares the two.
program numbers

  fn main
    let side = 3
    let area = side * side
    print("a square of side {side} has area {area}")
    let radius = 1.5
    let circle = pi() * radius * radius
    print("a circle of radius {radius} has area {circle}")
    print("rounded {circle.round()}, floor {circle.floor()}, ceil {circle.ceil()}, as an int {circle.to_int()}")
    print("the mean of 7 and 2 is {mean(7, 2)}")
    print("-7 / 2 is {-7 / 2}, -7 % 2 is {-7 % 2}, -7.0 / 2.0 is {-7.0 / 2.0}, 5.0 % 3.0 is {5.0 % 3.0}")
    print("0.1 + 0.2 is {0.1 + 0.2}")
    print("2 to the 62 is {2.pow(62)}, and 2.0 to the 10 is {2.0.pow(10)}")
    print("the hypotenuse of 3 and 4 is {hypotenuse(3.0, 4.0)}")
    print("big {1000000000000000000000.0}, small {0.00000015}, 1/3 {1.0 / 3.0}")
    let missing = 0.0 / 0.0
    print("1.0 / 0.0 is {1.0 / 0.0}, -1.0 / 0.0 is {-1.0 / 0.0}, 0.0 / 0.0 is {missing}")
    print("nan is nan: {missing is missing}; is_nan: {missing.is_nan()}")
    print("(-2.5).round() is {(-2.5).round()}, (-4).abs() is {(-4).abs()}, 2.5.min(1.5) is {2.5.min(1.5)}")
    print((side > 2 and area < 10) or side is 0)
  end fn main

  fn pi: float
    return 3.141592653589793
  end fn pi

  fn mean(a: int, b: int): float
    return (a + b).to_float() / 2.0
  end fn mean

  fn hypotenuse(a: float, b: float): float
    return (a * a + b * b).sqrt()
  end fn hypotenuse

end program numbers
