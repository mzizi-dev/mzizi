## A rule between things. Decorative by default, so it is hidden from assistive tech.
## Corpus reference: n2-primitives/separator.tsx.
component separator

  enum separator_axis
    horizontal  class "h-px w-full"
    vertical    class "w-px self-stretch"
  end

  prop axis: separator_axis = horizontal
  prop decorative: bool = true

  view
    rule
      slot = "separator"
      portal = "https://mzizi.dev/components/separator"
      axis = axis
      role = "none" when decorative else "separator"
      aria_orientation = none when decorative else "vertical" when axis is vertical
      class = "shrink-0 bg-border {axis.class}"
    end
  end

  contract
    separator_axis.horizontal class contains "w-full"
    separator_axis.vertical class contains "self-stretch"
    slot is "separator"
    render of slot is "separator"
    render of axis is "horizontal"
    render with axis = vertical of axis is "vertical"
    render with axis = vertical of class contains "self-stretch"
    render of role is "none"
    render with decorative = false of role is "separator"
    render with decorative = false axis = vertical of aria_orientation is "vertical"
    render with decorative = false omits "aria-orientation"
    render with axis = vertical omits "aria-orientation"
    render omits "data-decorative"
  end

end component separator
