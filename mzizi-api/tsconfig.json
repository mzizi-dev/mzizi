{
  // Extends the root config so `@/*` resolves to the repo root — the API
  // Worker imports `app/api/**` and `lib/**` directly, and those modules use
  // the `@/` alias among themselves.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "../lib/**/*.ts", "../app/api/**/*.ts"]
}
