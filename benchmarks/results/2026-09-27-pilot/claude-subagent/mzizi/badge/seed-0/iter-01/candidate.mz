## Badge: a small inline label for status or metadata.
## Not a touch target — informational only, so no 48px floor applies.
component badge

  enum badge_variant
    default     class "bg-primary text-primary-foreground"
    secondary   class "bg-secondary text-secondary-foreground"
    destructive class "bg-destructive/10 text-destructive dark:bg-destructive/20"
    outline     class "border-border text-foreground bg-input/30"
    ghost       class "hover:bg-muted hover:text-muted-foreground"
    link        class "text-primary underline-offset-4 hover:underline"
  end

  prop variant: badge_variant = default
  prop label: text

  view
    row
      slot = "badge"
      class = "inline-flex items-center justify-center gap-1 rounded-md border border-transparent px-2 py-0.5 h-5 w-fit whitespace-nowrap shrink-0 text-xs font-medium {variant.class}"
      text = label
    end
  end

  contract
    every badge_variant class not_empty
    badge_variant.default class contains "bg-primary"
    badge_variant.secondary class contains "bg-secondary"
    badge_variant.destructive class contains "bg-destructive"
    badge_variant.outline class contains "border-border"
    badge_variant.ghost class contains "hover:bg-muted"
    badge_variant.link class contains "text-primary"
    slot is "badge"
    variant is default
  end

end component badge
