## A pill-shaped button: a single `button` element, styled from semantic colour tokens.
component button

  enum button_variant
    default      class "bg-primary text-primary-foreground hover:bg-primary/80"
    outline      class "border-border bg-input/30 hover:bg-input/50 hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground"
    secondary    class "bg-secondary text-secondary-foreground hover:bg-secondary/80 aria-expanded:bg-secondary aria-expanded:text-secondary-foreground"
    ghost        class "hover:bg-muted hover:text-foreground dark:hover:bg-muted/50 aria-expanded:bg-muted aria-expanded:text-foreground"
    destructive  class "bg-destructive/10 hover:bg-destructive/20 focus-visible:ring-destructive/20 dark:focus-visible:ring-destructive/40 dark:bg-destructive/20 text-destructive focus-visible:border-destructive/40 dark:hover:bg-destructive/30"
    link         class "text-primary underline-offset-4 hover:underline"
  end

  enum button_size
    default   class "h-14 gap-2 px-5 has-data-[icon=inline-end]:pr-4 has-data-[icon=inline-start]:pl-4"
    sm        class "h-12 gap-1.5 px-4 has-data-[icon=inline-end]:pr-3 has-data-[icon=inline-start]:pl-3"
    lg        class "h-14 gap-2 px-6 has-data-[icon=inline-end]:pr-5 has-data-[icon=inline-start]:pl-5"
    icon      class "size-14"
    icon_sm   class "size-12"
  end

  prop variant: button_variant = default
  prop size: button_size = default
  prop label: text
  prop extra_class: text = ""
  prop on_tap: event(none)

  view
    button
      slot = "button"
      portal = "https://mzizi.dev/components/button"
      variant = variant
      size = size
      class = "focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 rounded-full border border-transparent bg-clip-padding text-sm font-medium focus-visible:ring-[3px] aria-invalid:ring-[3px] [&_svg:not([class*='size-'])]:size-4 inline-flex items-center justify-center whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none shrink-0 [&_svg]:shrink-0 outline-none group/button select-none {variant.class} {size.class} {extra_class}"
      tap = on_tap
      text = label
    end
  end

  contract
    slot is "button"
    every button_size height at_least 48
    button_size.default height is 56
    button_size.sm height is 48
    button_size.icon_sm height is 48
    every button_variant class not_empty
  end

end component button
