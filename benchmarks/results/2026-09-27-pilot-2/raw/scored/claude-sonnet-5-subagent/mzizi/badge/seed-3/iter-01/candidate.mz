## A badge: a small inline label for status, category or count.
## It is not a touch control, so no minimum touch target applies.
component badge

  enum badge_variant
    default      class "bg-primary text-primary-foreground [a]:hover:bg-primary/80"
    secondary    class "bg-secondary text-secondary-foreground [a]:hover:bg-secondary/80"
    destructive  class "bg-destructive/10 [a]:hover:bg-destructive/20 text-destructive dark:bg-destructive/20"
    outline      class "border-border text-foreground [a]:hover:bg-muted bg-input/30"
    ghost        class "hover:bg-muted hover:text-muted-foreground dark:hover:bg-muted/50"
    link         class "text-primary underline-offset-4 hover:underline"
  end

  prop variant: badge_variant = default
  prop label: text

  view
    row
      slot = "badge"
      class = "h-5 gap-1 rounded-md border border-transparent px-2 py-0.5 text-xs font-medium inline-flex items-center justify-center w-fit whitespace-nowrap shrink-0 overflow-hidden {variant.class}"
      text = label
    end
  end

  contract
    slot is "badge"
    variant is default
    every badge_variant class not_empty
    badge_variant.default class contains "bg-primary"
    badge_variant.secondary class contains "bg-secondary"
    badge_variant.destructive class contains "bg-destructive"
    badge_variant.outline class contains "border-border"
    badge_variant.ghost class contains "hover:bg-muted"
    badge_variant.link class contains "text-primary"
  end

end component badge
