## A container for grouped content: header, title, description, action, content and footer
## parts inside a card, with a pulsing skeleton while it loads.
component card

  enum card_size
    default  class ""  loading_class ""
    sm       class ""  loading_class "gap-3 p-4"
  end

  prop size: card_size = default
  prop loading: bool = false
  prop title: option(text)
  prop description: option(text)
  prop action: option(text)
  prop children: text
  prop footer: option(text)

  view
    when loading
      row
        slot = "card"
        portal = "https://mzizi.dev/components/card"
        size = size
        loading = true
        class = "group/card flex animate-pulse flex-col gap-4 overflow-hidden rounded-[var(--radius-lg,14px)] bg-card p-6 text-sm ring-1 ring-foreground/10 {size.loading_class}"
        row
          class = "h-4 w-2/3 rounded bg-muted"
        end
        row
          class = "h-3 w-full rounded bg-muted"
        end
        row
          class = "h-3 w-4/5 rounded bg-muted"
        end
      end
    else
      row
        slot = "card"
        size = size
        class = "group/card flex flex-col gap-6 overflow-hidden rounded-[var(--radius-lg,14px)] bg-card py-6 text-sm text-card-foreground ring-1 ring-foreground/10 has-[>img:first-child]:pt-0 data-[size=sm]:gap-4 data-[size=sm]:py-4 *:[img:first-child]:rounded-t-[var(--radius-md,12px)] *:[img:last-child]:rounded-b-[var(--radius-md,12px)] {size.class}"
        row
          slot = "card-header"
          class = "group/card-header @container/card-header grid auto-rows-min items-start gap-2 rounded-t-[var(--radius-md,12px)] px-6 group-data-[size=sm]/card:px-4 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] [.border-b]:pb-6 group-data-[size=sm]/card:[.border-b]:pb-4"
          when title is none
            nothing
          else
            row
              slot = "card-title"
              class = "text-base font-medium"
              text = title
            end
          end
          when description is none
            nothing
          else
            row
              slot = "card-description"
              class = "text-sm text-muted-foreground"
              text = description
            end
          end
          when action is none
            nothing
          else
            row
              slot = "card-action"
              class = "col-start-2 row-span-2 row-start-1 self-start justify-self-end"
              text = action
            end
          end
        end
        row
          slot = "card-content"
          class = "px-6 group-data-[size=sm]/card:px-4"
          text = children
        end
        when footer is none
          nothing
        else
          row
            slot = "card-footer"
            class = "flex items-center rounded-b-[var(--radius-md,12px)] px-6 group-data-[size=sm]/card:px-4 [.border-t]:pt-6 group-data-[size=sm]/card:[.border-t]:pt-4"
            text = footer
          end
        end
      end
    end
  end

  contract
    slot is "card"
    size is default
    loading is false
    card_size.sm loading_class is "gap-3 p-4"
  end

end component card
