## B1's Mzizi reference: the registry's routes, in RFC-0011's service form. HEAD, OPTIONS,
## 405 and the trailing-slash 308 are the runtime's (RFC-0011 §6), so they are not written.
service registry

  header "x-mzizi-source" "registry"

  record health
    field status: text
  end

  record listing
    field count: int
  end

  record item
    field name: text
  end

  record problem
    field error: text
  end

  route health_check
    get "/v1/health"
    respond 200 json health status "ok"
  end

  route ui_list
    get "/v1/ui"
    respond 200 json listing count 2
  end

  route ui_item
    get "/v1/ui/{name}"
    when name in "badge" "button"
      respond 200 json item name name
    end
    header "cache-control" "private, no-cache, no-store, max-age=0, must-revalidate"
    respond 404 json problem error "Not found"
  end

  fallback
    header "cache-control" "private, no-cache, no-store, max-age=0, must-revalidate"
    respond 404 json problem error "Not found"
  end

  contract
    example get "/v1/health" body.status is "ok"
    example get "/v1/ui" body.count is 2
    example get "/v1/ui/badge" body.name is "badge"
    example get "/v1/ui/card" status is 404
    example head "/v1/ui/button" body is ""
    example options "/v1/ui/card" header "allow" is "GET, HEAD, OPTIONS"
    example delete "/v1/ui/button" status is 405
    example get "/v1/ui/?page=2" header "location" is "/v1/ui?page=2"
    example get "/V1/UI" status is 404
    ensure status in 200 204 308 404 405
    ensure header "x-mzizi-source" is "registry"
    ensure when status is 404 then body.error is "Not found"
    ensure when status is 404 then header "cache-control" is "private, no-cache, no-store, max-age=0, must-revalidate"
    ensure when status is 405 then header "allow" is "GET, HEAD, OPTIONS"
  end

end service registry
